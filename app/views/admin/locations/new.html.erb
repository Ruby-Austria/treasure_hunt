<div class="bg-white rounded-lg shadow-md p-6 mb-8 flex justify-between items-center">
  <h2 class="text-2xl font-semibold text-gray-900">New Location</h2>
  <div class="flex gap-3 items-center">
    <%= link_to "Back to Locations", admin_locations_path, class: "px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-md p-8 max-w-3xl">
  <%= form_with model: [:admin, @location], local: true, class: "space-y-6" do |form| %>
    <% if @location.errors.any? %>
      <div class="p-4 bg-red-50 text-red-800 border border-red-200 rounded-lg">
        <h3 class="font-semibold mb-2">Please fix the following errors:</h3>
        <ul class="list-disc list-inside text-sm space-y-1">
          <% @location.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Name *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :lat, "Latitude *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :lat, step: 0.0000001, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
      <div>
        <%= form.label :long, "Longitude *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :long, step: 0.0000001, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :country, "Country *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :country, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
      <div>
        <%= form.label :city, "City *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :city, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :difficulty, "Difficulty *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.select :difficulty, Location.difficulties.keys.map { |k| [k.humanize, k] }, {}, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
      <div>
        <%= form.label :unlock_radius, "Unlock Radius (meters)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :unlock_radius, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
    </div>

    <div>
      <%= form.label :description, "Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :reasoning, "Reasoning", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :reasoning, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :tag_list, "Tags (comma-separated)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :tag_list, value: @location.tag_list, placeholder: "e.g., outdoor, park, family-friendly", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">Enter tags separated by commas</p>
    </div>

    <div class="flex gap-3 pt-4">
      <%= form.submit "Create Location", class: "px-6 py-3 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_locations_path, class: "px-6 py-3 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    </div>
  <% end %>
</div>
