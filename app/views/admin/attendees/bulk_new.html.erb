<div class="max-w-lg">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Bulk Import Attendees</h1>
  <p class="text-sm text-gray-500 mb-6">Enter email addresses, one per line. A random password will be generated for each.</p>

  <%= form_with url: bulk_create_admin_attendees_path, method: :post, class: "space-y-6" do |form| %>
    <div>
      <%= form.label :emails, "Email Addresses", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :emails, rows: 12, required: true, placeholder: "alice@example.com\nbob@example.com\ncharlie@example.com", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 font-mono text-sm" %>
      <p class="text-xs text-gray-500 mt-1">Separate emails by newlines, commas, or semicolons. Duplicates are automatically removed.</p>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Import Attendees", class: "px-6 py-3 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_attendees_path, class: "px-6 py-3 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    </div>
  <% end %>
</div>
