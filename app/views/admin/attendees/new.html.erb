<div class="max-w-md">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Add Attendee</h1>

  <% if @user.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <ul class="text-sm text-red-800 space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [:admin, @user], url: admin_attendees_path, class: "space-y-6" do |form| %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :first_name, "First Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :first_name, autofocus: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500" %>
      </div>
      <div>
        <%= form.label :last_name, "Last Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :last_name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500" %>
      </div>
    </div>

    <div>
      <%= form.label :email, "Email", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.email_field :email, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500" %>
      <p class="text-xs text-gray-500 mt-1">A random password will be auto-generated</p>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Create Attendee", class: "px-6 py-3 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_attendees_path, class: "px-6 py-3 text-sm font-semibold text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    </div>
  <% end %>
</div>
