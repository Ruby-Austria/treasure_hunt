<div class="bg-white rounded-lg shadow-md p-6 mb-8 flex justify-between items-center">
  <h2 class="text-2xl font-semibold text-gray-900"><%= @hunt.name %></h2>
  <div class="flex gap-3 items-center">
    <%= link_to "Edit", edit_admin_hunt_path(@hunt), class: "px-4 py-2 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors" %>
    <%= button_to "Delete", admin_hunt_path(@hunt), method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this hunt?" },
        class: "px-4 py-2 text-sm font-semibold text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors cursor-pointer" %>
    <%= link_to "Back to Hunts", admin_hunts_path, class: "px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-md p-8 max-w-4xl">
  <div class="grid md:grid-cols-2 gap-8 mb-8">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h3>
      <dl class="space-y-4">
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Name</dt>
          <dd class="text-gray-900 text-lg"><%= @hunt.name %></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Status</dt>
          <dd>
            <span class="text-sm font-semibold px-3 py-1 rounded <%= @hunt.draft? ? 'bg-yellow-50 text-yellow-700' : @hunt.approved? ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
              <%= @hunt.status.humanize %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Hunt Type</dt>
          <dd><span class="text-sm font-medium px-3 py-1 rounded bg-gray-100 text-gray-600"><%= @hunt.hunt_type.humanize %></span></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Language</dt>
          <dd class="text-gray-900"><%= @hunt.language.upcase %></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Description</dt>
          <dd class="text-gray-700"><%= @hunt.description.present? ? @hunt.description : content_tag(:span, "No description", class: "text-gray-500 italic") %></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Completion Message</dt>
          <dd class="text-gray-700"><%= @hunt.completion_message.present? ? @hunt.completion_message : content_tag(:span, "No custom message (default will be shown)", class: "text-gray-500 italic") %></dd>
        </div>
      </dl>
    </div>

    <div>
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Hunt Details</h3>
      <dl class="space-y-4">
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Difficulty</dt>
          <dd><span class="text-sm font-medium px-3 py-1 rounded bg-gray-100 text-gray-600"><%= @hunt.difficulty.humanize %></span></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Price</dt>
          <dd class="text-lg font-bold text-gray-900"><%= @hunt.price > 0 ? "$#{sprintf('%.2f', @hunt.price)}" : "Free" %></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Locations</dt>
          <dd>
            <% if @hunt.locations.any? %>
              <div class="flex flex-wrap gap-2 mb-2">
                <% @hunt.locations.each do |location| %>
                  <%= link_to location.name, admin_location_path(location), class: "inline-block px-2 py-1 text-sm bg-ruby-50 text-ruby-600 hover:text-ruby-700 rounded" %>
                <% end %>
              </div>
              <p class="text-xs text-gray-500">
                Locations are linked through clues. <%= link_to "Manage clues →", admin_clues_path(hunt_id: @hunt.id), class: "text-ruby-600 hover:text-ruby-700" %>
              </p>
            <% else %>
              <span class="text-gray-500 italic">No locations</span>
              <p class="text-xs text-gray-500 mt-1">
                <%= link_to "Add clues to link locations →", new_admin_clue_path(hunt_id: @hunt.id), class: "text-ruby-600 hover:text-ruby-700" %>
              </p>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Tags</dt>
          <dd>
            <% if @hunt.tags.any? %>
              <div class="flex flex-wrap gap-2">
                <% @hunt.tags.map(&:name).each do |tag| %>
                  <span class="inline-block px-2 py-1 text-sm bg-ruby-50 text-gray-700 rounded"><%= tag %></span>
                <% end %>
              </div>
            <% else %>
              <span class="text-gray-500 italic">No tags</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @hunt.clues.any? %>
    <div class="mb-8 pt-8 border-t border-gray-200">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Clues (<%= @hunt.clues.size %>)</h3>
        <%= link_to "Manage Clues →", admin_clues_path(hunt_id: @hunt.id), class: "px-4 py-2 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors" %>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <% @hunt.clues.each do |clue| %>
          <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <div class="flex justify-between items-start mb-2">
              <%= link_to clue.location.name, admin_location_path(clue.location), class: "font-semibold text-ruby-600 hover:text-ruby-700" %>
              <span class="text-xs font-medium px-2 py-1 rounded bg-gray-100 text-gray-500"><%= clue.difficulty.humanize %></span>
            </div>
            <% clue_text = clue.riddle.presence || clue.description %>
            <% if clue_text.present? %>
              <p class="text-sm text-gray-600 mb-2 leading-relaxed"><%= truncate(clue_text, length: 100) %></p>
            <% end %>
            <%= link_to "View Clue →", admin_clue_path(clue), class: "text-sm text-ruby-600 hover:text-ruby-700" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @hunt.has_treasure? %>
    <div class="mb-8 pt-8 border-t border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Endgame / Treasure</h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Location</dt>
          <dd class="text-gray-900"><%= @hunt.treasure_location %></dd>
        </div>
        <% if @hunt.treasure_access_code.present? %>
          <div>
            <dt class="text-sm font-semibold text-gray-500 mb-1">Access Code</dt>
            <dd class="text-gray-900 font-mono font-bold"><%= @hunt.treasure_access_code %></dd>
          </div>
        <% end %>
        <% if @hunt.treasure_hint.present? %>
          <div>
            <dt class="text-sm font-semibold text-gray-500 mb-1">Hint</dt>
            <dd class="text-gray-900"><%= @hunt.treasure_hint %></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-sm font-semibold text-gray-500 mb-1">Status</dt>
          <dd>
            <% if @hunt.treasure_claimed? %>
              <span class="text-sm font-medium px-3 py-1 rounded bg-yellow-50 text-yellow-700">Claimed by <%= @hunt.treasure_claimed_by %> at <%= @hunt.treasure_claimed_at.strftime("%b %d, %H:%M") %></span>
            <% else %>
              <span class="text-sm font-medium px-3 py-1 rounded bg-green-50 text-green-700">Available</span>
              <%= button_to "Mark as Claimed", admin_hunt_path(@hunt, hunt: { treasure_claimed_at: Time.current, treasure_claimed_by: "Admin" }), method: :patch, class: "ml-2 text-sm text-ruby-600 hover:text-ruby-700 underline cursor-pointer" %>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  <% end %>

  <div class="pt-8 border-t border-gray-200 text-sm text-gray-500">
    <p>Created: <%= @hunt.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
    <p>Last updated: <%= @hunt.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
  </div>
</div>
