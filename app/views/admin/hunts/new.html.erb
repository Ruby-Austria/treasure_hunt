<div class="bg-white rounded-lg shadow-md p-6 mb-8 flex justify-between items-center">
  <h2 class="text-2xl font-semibold text-gray-900">New Hunt</h2>
  <div class="flex gap-3 items-center">
    <%= link_to "Back to Hunts", admin_hunts_path, class: "px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-md p-8 max-w-3xl">
  <%= form_with model: [:admin, @hunt], local: true, class: "space-y-6" do |form| %>
    <% if @hunt.errors.any? %>
      <div class="p-4 bg-red-50 text-red-800 border border-red-200 rounded-lg">
        <h3 class="font-semibold mb-2">Please fix the following errors:</h3>
        <ul class="list-disc list-inside text-sm space-y-1">
          <% @hunt.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Name *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :description, "Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :status, "Status *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.select :status, Hunt.statuses.keys.map { |k| [k.humanize, k] }, {}, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
      <div>
        <%= form.label :difficulty, "Difficulty *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.select :difficulty, Hunt.difficulties.keys.map { |k| [k.humanize, k] }, {}, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :hunt_type, "Hunt Type *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.select :hunt_type, Hunt.hunt_types.keys.map { |k| [k.humanize, k] }, {}, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
      <div>
        <%= form.label :price, "Price *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.number_field :price, step: 0.01, min: 0, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      </div>
    </div>

    <div>
      <%= form.label :language, "Language *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :language, placeholder: "e.g., en, fr, es", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">ISO 639-1 language code (default: en)</p>
    </div>

    <div>
      <%= form.label :tag_list, "Tags (comma-separated)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :tag_list, value: @hunt.tag_list, placeholder: "e.g., outdoor, adventure, family-friendly", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">Enter tags separated by commas</p>
    </div>

    <div>
      <%= form.label :completion_message, "Completion Message", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :completion_message, rows: 4, placeholder: "Custom message shown when users complete the hunt. Leave blank for default.", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">This message will be shown to users when they complete the hunt. Leave blank to use the default message.</p>
    </div>

    <div class="flex gap-3 pt-4">
      <%= form.submit "Create Hunt", class: "px-6 py-3 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_hunts_path, class: "px-6 py-3 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    </div>
  <% end %>
</div>
