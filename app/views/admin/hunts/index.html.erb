<div class="bg-white rounded-lg shadow-md p-6 mb-8 flex justify-between items-center">
  <h2 class="text-2xl font-semibold text-gray-900">Hunts</h2>
  <div class="flex gap-3 items-center">
    <%= link_to "New Hunt", new_admin_hunt_path, class: "px-4 py-2 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-md p-6">
  <% if @hunts.any? %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b-2 border-gray-200">
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Name</th>
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Status</th>
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Type</th>
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Difficulty</th>
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Price</th>
            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-500">Language</th>
            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @hunts.each do |hunt| %>
            <tr class="border-b border-gray-100 hover:bg-gray-50">
              <td class="py-3 px-4">
                <%= link_to hunt.name, admin_hunt_path(hunt), class: "text-ruby-600 hover:text-ruby-700 font-medium" %>
              </td>
              <td class="py-3 px-4">
                <span class="text-xs font-semibold px-2 py-1 rounded <%= hunt.draft? ? 'bg-yellow-50 text-yellow-700' : hunt.approved? ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' %>">
                  <%= hunt.status.humanize %>
                </span>
              </td>
              <td class="py-3 px-4">
                <span class="text-xs font-medium px-2 py-1 rounded bg-gray-100 text-gray-600"><%= hunt.hunt_type.humanize %></span>
              </td>
              <td class="py-3 px-4">
                <span class="text-xs font-medium px-2 py-1 rounded bg-gray-100 text-gray-600"><%= hunt.difficulty.humanize %></span>
              </td>
              <td class="py-3 px-4 text-gray-600">
                <%= hunt.price > 0 ? "$#{sprintf('%.2f', hunt.price)}" : "Free" %>
              </td>
              <td class="py-3 px-4 text-gray-600"><%= hunt.language.upcase %></td>
              <td class="py-3 px-4 text-right">
                <div class="flex gap-2 justify-end items-center">
                  <%= link_to "Edit", edit_admin_hunt_path(hunt), class: "px-3 py-1 text-xs font-semibold text-gray-600 bg-gray-100 rounded hover:bg-gray-200 transition-colors" %>
                  <%= button_to "Delete", admin_hunt_path(hunt), method: :delete,
                      data: { turbo_confirm: "Are you sure?" },
                      class: "px-3 py-1 text-xs font-semibold text-white bg-red-600 rounded hover:bg-red-700 transition-colors cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-500">
      <p class="text-lg mb-4">No hunts found.</p>
      <%= link_to "Create your first hunt", new_admin_hunt_path, class: "inline-block px-4 py-2 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors" %>
    </div>
  <% end %>
</div>
