<div class="bg-white rounded-lg shadow-md p-6 mb-8 flex justify-between items-center">
  <h2 class="text-2xl font-semibold text-gray-900">New Clue</h2>
  <div class="flex gap-3 items-center">
    <%= link_to "Back to Clues", admin_clues_path, class: "px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-md p-8 max-w-3xl">
  <%= form_with model: [:admin, @clue], local: true, class: "space-y-6" do |form| %>
    <% if @clue.errors.any? %>
      <div class="p-4 bg-red-50 text-red-800 border border-red-200 rounded-lg">
        <h3 class="font-semibold mb-2">Please fix the following errors:</h3>
        <ul class="list-disc list-inside text-sm space-y-1">
          <% @clue.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :hunt_id, "Hunt *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.collection_select :hunt_id, Hunt.order(:name), :id, :name, { prompt: "Select a hunt" }, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
      <div>
        <%= form.label :location_id, "Location *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.collection_select :location_id, Location.order(:name), :id, :name, { prompt: "Select a location" }, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
      </div>
    </div>

    <div>
      <%= form.label :difficulty, "Difficulty *", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.select :difficulty, Clue.difficulties.keys.map { |k| [k.humanize, k] }, {}, { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" } %>
    </div>

    <div>
      <%= form.label :description, "Description", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :reasoning, "Reasoning", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :reasoning, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
    </div>

    <div>
      <%= form.label :hints, "Hints (comma-separated)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_field :hints, value: @clue.hints&.join(", "), placeholder: "e.g., Look for a red door, Check near the entrance, Ask the guard", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">Enter hints separated by commas</p>
    </div>

    <div>
      <%= form.label :fun_fact, "Fun Fact", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= form.text_area :fun_fact, rows: 3, placeholder: "e.g., This location was built in 1920 and is featured in a famous movie", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ruby-500 focus:border-ruby-500 transition-colors" %>
      <p class="mt-1 text-sm text-gray-500">Enter a fun fact about this location. This will be shown to users after they claim the clue.</p>
    </div>

    <div class="flex gap-3 pt-4">
      <%= form.submit "Create Clue", class: "px-6 py-3 text-sm font-semibold text-white bg-ruby-600 rounded-lg hover:bg-ruby-700 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", admin_clues_path, class: "px-6 py-3 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    </div>
  <% end %>
</div>
