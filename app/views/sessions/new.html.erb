<div class="min-h-dvh grid lg:grid-cols-2 -mt-14 bg-warm-900 text-white antialiased font-['Inter']">
  <%# Left: dark hero panel %>
  <div class="relative bg-warm-900 text-white overflow-hidden isolate flex items-end px-6 sm:px-10 lg:px-14 pt-24 pb-10 lg:py-14 min-h-[260px] lg:min-h-dvh">
    <div class="absolute -top-40 -right-40 size-[26rem] rounded-full bg-ruby-600/30 blur-[140px] pointer-events-none" aria-hidden="true"></div>
    <%= image_tag "treasure_chest.webp", alt: "Treasure chest", class: "absolute inset-0 size-full object-cover opacity-25 mix-blend-luminosity pointer-events-none" %>
    <div class="absolute inset-0 bg-linear-to-t from-warm-900 via-warm-900/70 to-warm-900/30 pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-md font-['Inter']">
      <p class="text-xs font-medium text-ruby-400 uppercase tracking-[0.2em] mb-4"><%= Conference.name %> · <%= Conference.city %></p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-balance leading-[1.1]">
        Two hunts. One €3,000 chest. One sweet reward.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-white/70 max-w-[44ch] text-pretty hidden sm:block">
        Sign in with your conference credentials to start solving riddles across the city.
      </p>
    </div>
  </div>

  <%# Right: form %>
  <div class="relative flex items-center justify-center px-6 sm:px-10 py-12 sm:py-16">
    <div class="absolute top-1/3 right-0 size-[20rem] rounded-full bg-ruby-500/10 blur-[120px] pointer-events-none hidden lg:block" aria-hidden="true"></div>
    <div class="relative w-full max-w-xs">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ruby-400 mb-3">Authenticate</p>
      <h1 class="font-['Fraunces'] italic text-3xl sm:text-4xl tracking-tight leading-[1.05]">Sign in.</h1>
      <p class="mt-2 text-sm text-white/55">Welcome back, Rubyist.</p>

      <%= form_with url: login_path, class: "mt-8 space-y-4" do |form| %>
        <div>
          <%= form.label :email, "Email", class: "block text-xs font-mono uppercase tracking-[0.2em] text-white/55 mb-2" %>
          <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "w-full px-3.5 py-2.5 max-sm:text-base/6 text-sm bg-white/[0.04] ring-1 ring-white/15 rounded-lg text-white placeholder:text-white/30 focus:outline focus:outline-2 -outline-offset-1 focus:outline-ruby-500 focus:bg-white/[0.06] transition-all" %>
        </div>
        <div>
          <%= form.label :password, "Password", class: "block text-xs font-mono uppercase tracking-[0.2em] text-white/55 mb-2" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full px-3.5 py-2.5 max-sm:text-base/6 text-sm bg-white/[0.04] ring-1 ring-white/15 rounded-lg text-white placeholder:text-white/30 focus:outline focus:outline-2 -outline-offset-1 focus:outline-ruby-500 focus:bg-white/[0.06] transition-all" %>
        </div>
        <%= form.submit "Sign in →", class: "group w-full mt-2 px-5 py-3 text-sm font-semibold bg-ruby-500 text-white rounded-lg hover:bg-ruby-400 transition-colors ring-1 ring-ruby-500 shadow-[0_8px_30px_-5px_rgba(227,8,24,0.5)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ruby-300 cursor-pointer" %>
      <% end %>

      <p class="mt-8 text-xs text-white/40">
        <%= link_to "← Back to home", root_path, class: "hover:text-white/70 transition-colors" %>
      </p>
    </div>
  </div>
</div>
