<div class="min-h-dvh bg-warm-900 text-white antialiased font-['Inter'] relative overflow-hidden isolate">
  <%# Ambient ruby glow %>
  <div class="absolute -top-40 -right-40 size-[24rem] sm:size-[36rem] rounded-full bg-ruby-600/30 blur-[120px] sm:blur-[140px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/3 -left-40 size-[20rem] sm:size-[28rem] rounded-full bg-ruby-500/15 blur-[100px] sm:blur-[120px] pointer-events-none" aria-hidden="true"></div>

  <%# Hero %>
  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pt-10 sm:pt-20 lg:pt-24 pb-14 sm:pb-24 lg:pb-32">
    <div class="grid lg:grid-cols-12 gap-10 sm:gap-12 lg:gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 ring-1 ring-white/10 mb-6 sm:mb-8">
          <span class="size-1.5 rounded-full bg-ruby-400 animate-pulse"></span>
          <p class="text-xs font-medium text-white/70 tracking-wide">Live · <%= Conference.dates %> · <%= Conference.city %></p>
        </div>

        <h1 class="font-['Inter'] font-semibold text-4xl sm:text-5xl lg:text-7xl tracking-tight text-balance leading-[1.05] max-w-[18ch]">
          Hunt for treasure across <span class="bg-linear-to-r from-ruby-300 to-ruby-500 bg-clip-text text-transparent"><%= Conference.city %></span>.
        </h1>
        <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-white/60 max-w-[56ch] text-pretty">
          Two hunts crafted for RubyConf Austria attendees. One ends at a €3,000 treasure chest. The other? A sweet reward.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
          <%= link_to login_path, class: "group inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-3 text-sm font-semibold bg-ruby-500 text-white rounded-lg hover:bg-ruby-400 transition-colors ring-1 ring-ruby-500 shadow-[0_8px_30px_-5px_rgba(227,8,24,0.5)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ruby-300" do %>
            Log in to start
            <svg class="size-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10m0 0L9 4m4 4l-4 4"/></svg>
          <% end %>
          <%= link_to "View leaderboard", leaderboard_path, class: "inline-flex items-center justify-center gap-2 w-full sm:w-auto px-5 py-3 text-sm font-semibold text-white/80 hover:text-white rounded-lg ring-1 ring-white/15 hover:ring-white/30 hover:bg-white/5 transition-all" %>
        </div>

        <%# Stats strip %>
        <dl class="mt-10 sm:mt-14 grid grid-cols-3 gap-4 sm:gap-6 max-w-md">
          <div>
            <dt class="text-[10px] sm:text-xs text-white/50 uppercase tracking-wider mb-1">Hunts</dt>
            <dd class="text-xl sm:text-2xl font-semibold tabular-nums">02</dd>
          </div>
          <div>
            <dt class="text-[10px] sm:text-xs text-white/50 uppercase tracking-wider mb-1">Days</dt>
            <dd class="text-xl sm:text-2xl font-semibold tabular-nums">03</dd>
          </div>
          <div>
            <dt class="text-[10px] sm:text-xs text-white/50 uppercase tracking-wider mb-1">Prize</dt>
            <dd class="text-xl sm:text-2xl font-semibold tabular-nums">€3K</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="relative">
          <div class="absolute -inset-4 bg-linear-to-tr from-ruby-600/40 via-ruby-400/20 to-transparent rounded-2xl blur-2xl" aria-hidden="true"></div>
          <%= image_tag "treasure_chest.webp", alt: "Treasure chest worth 3,000 EUR", class: "relative w-full rounded-2xl ring-1 ring-white/10 shadow-2xl" %>
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 px-3 sm:px-4 py-2.5 sm:py-3 rounded-xl bg-warm-900/80 backdrop-blur ring-1 ring-white/10 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[10px] text-white/50 uppercase tracking-widest">The chest</p>
              <p class="text-sm font-semibold truncate">Worth €3,000</p>
            </div>
            <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wider bg-ruby-500/20 text-ruby-300 ring-1 ring-ruby-500/30 whitespace-nowrap">1 of 2</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# How it works — card grid %>
  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-12 sm:py-20 lg:py-24">
    <div class="mb-8 sm:mb-12">
      <p class="text-xs font-medium text-ruby-400 uppercase tracking-[0.2em] mb-3">How it works</p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight max-w-[28ch] text-balance">
        Three steps to the treasure.
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-3 sm:gap-4">
      <div class="group relative p-5 sm:p-6 rounded-2xl bg-white/[0.03] ring-1 ring-white/10 hover:ring-ruby-500/40 hover:bg-white/[0.05] transition-all">
        <div class="flex items-center justify-between mb-6 sm:mb-8">
          <span class="tabular-nums text-sm font-semibold text-white/40">01</span>
          <div class="size-9 rounded-lg bg-ruby-500/15 ring-1 ring-ruby-500/30 flex items-center justify-center text-ruby-300">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
        </div>
        <h3 class="text-base sm:text-lg font-semibold mb-2 tracking-tight">Form a team</h3>
        <p class="text-sm text-white/60 text-pretty">Solo or squad. Share an invite code to join forces with fellow attendees.</p>
      </div>

      <div class="group relative p-5 sm:p-6 rounded-2xl bg-white/[0.03] ring-1 ring-white/10 hover:ring-ruby-500/40 hover:bg-white/[0.05] transition-all">
        <div class="flex items-center justify-between mb-6 sm:mb-8">
          <span class="tabular-nums text-sm font-semibold text-white/40">02</span>
          <div class="size-9 rounded-lg bg-ruby-500/15 ring-1 ring-ruby-500/30 flex items-center justify-center text-ruby-300">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
        </div>
        <h3 class="text-base sm:text-lg font-semibold mb-2 tracking-tight">Solve the clues</h3>
        <p class="text-sm text-white/60 text-pretty">Each hunt is a sequence of real <%= Conference.city %> locations. Walk there. Check in. Continue.</p>
      </div>

      <div class="group relative p-5 sm:p-6 rounded-2xl bg-white/[0.03] ring-1 ring-white/10 hover:ring-ruby-500/40 hover:bg-white/[0.05] transition-all">
        <div class="flex items-center justify-between mb-6 sm:mb-8">
          <span class="tabular-nums text-sm font-semibold text-white/40">03</span>
          <div class="size-9 rounded-lg bg-ruby-500/15 ring-1 ring-ruby-500/30 flex items-center justify-center text-ruby-300">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.5 6.5L21 9l-5 4.5L17.5 21 12 17l-5.5 4L8 13.5 3 9l6.5-.5z"/></svg>
          </div>
        </div>
        <h3 class="text-base sm:text-lg font-semibold mb-2 tracking-tight">Claim your prize</h3>
        <p class="text-sm text-white/60 text-pretty">One hunt ends at a €3,000 chest. The other at a sweet reward. First team to finish either claims it.</p>
      </div>
    </div>
  </div>

  <%# Leaderboard %>
  <% if @hunts.any? %>
    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-12 sm:py-20 lg:py-24">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
        <div>
          <p class="text-xs font-medium text-ruby-400 uppercase tracking-[0.2em] mb-3">The hunts</p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight max-w-[28ch] text-balance">
            Two hunts. One chest. One sweet reward.
          </h2>
        </div>
        <%= link_to "Full leaderboard →", leaderboard_path, class: "text-sm font-medium text-white/70 hover:text-white whitespace-nowrap" %>
      </div>

      <ul role="list" class="grid sm:grid-cols-2 gap-3">
        <% @hunts.each_with_index do |hunt, i| %>
          <li>
            <%= link_to hunt_path(hunt), class: "group block p-4 sm:p-5 rounded-xl bg-white/[0.03] ring-1 ring-white/10 hover:ring-white/20 transition-colors flex items-center justify-between gap-3 sm:gap-4" do %>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-mono text-white/40 tabular-nums">#<%= format("%02d", i + 1) %></span>
                  <h3 class="text-sm sm:text-base font-semibold tracking-tight truncate group-hover:text-ruby-300 transition-colors"><%= hunt.name %></h3>
                </div>
                <p class="text-xs text-white/50"><%= pluralize(hunt.clues.size, 'clue') %></p>
              </div>
              <span class="px-2.5 py-1 rounded-md text-[10px] font-semibold uppercase tracking-wider bg-white/5 text-white/50 ring-1 ring-white/10 whitespace-nowrap group-hover:bg-ruby-500/15 group-hover:text-ruby-300 group-hover:ring-ruby-500/30 transition-colors">View →</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-10 sm:py-12 border-t border-white/10">
    <p class="text-xs text-white/40">
      <% if Conference.website_url.present? %><%= link_to Conference.name, Conference.website_url, target: "_blank", class: "hover:text-ruby-400" %> · <% end %><%= Conference.city %>
    </p>
  </div>
</div>
